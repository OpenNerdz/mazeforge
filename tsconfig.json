{
  // Type-checks the plain JavaScript (no build step): npm run check
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["web/**/*.js", "web/lib/three.d.ts", "tests/**/*.mjs", "tools/**/*.mjs"],
  "exclude": ["web/lib/three.js", "web/worker.js"]
}
